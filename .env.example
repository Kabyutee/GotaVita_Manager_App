# Cloudflare Pages / public browser-safe Supabase settings.
# These values are safe to expose to the browser when Row Level Security is enabled.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# NEVER place a Supabase secret/service-role key in Cloudflare Pages browser code.
# Server-side migration/admin scripts must keep secret keys outside the public bundle.
